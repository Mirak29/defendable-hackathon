# Copy to .env.production on the server and fill it in. Never commit the copy.

# The public address of the app, with https and no trailing slash: it is the
# base of the personal links sent to candidates. Cookies are Secure: HTTPS only.
REDIRECT_URI=https://your-public-address

# Meta Model API (reports, Oracle, listening)
MODEL_API_KEY=
# Muse Spark Open served by Baseten (generation, CV, prefill)
BASETEN_API_KEY=

# E-mail of the personal links (Resend). Empty: the link is copied by hand.
RESEND_API_KEY=
RESEND_FROM=Defendable <onboarding@resend.dev>

# A ready-made demo company for the judges: the account is demo@defendable.invalid
# with this password (10 characters at least). Remove both lines to switch it off.
DEMO_ACCESS=1
DEMO_PASSWORD=

# The voice of Oracle is made on this machine by Meta's MMS-TTS (TTS=off: the
# browser's voice)
TTS=on

# Optional: the interview lasts 10 minutes from its first opening
# INTERVIEW_MS=600000

# Optional: the voice lab (/dev/voice) for the team. Off by default in production:
# with DEMO_ACCESS, any visitor is a member and would spend the model keys.
# VOICE_LAB=on
