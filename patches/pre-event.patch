-    Entry.insert.CANDIDATE_FINISHED({
-      companyId: companyOfAssessment(c.assessmentId),
-      assessmentId: c.assessmentId,
-      candidateId: c.candidateId,
-    })
-    buildReport(c.candidateId)
-  }
-  return { finished }
-}
