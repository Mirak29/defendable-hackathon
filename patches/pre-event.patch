+  for await (const part of res.body!) {
+    buffer += decoder.decode(part, { stream: true })
+    const lines = buffer.split('\n')
+    buffer = lines.pop()!
+    lines.forEach(line)
   }
+  line(buffer)
+  return { content, finish, usage }
 }
 
